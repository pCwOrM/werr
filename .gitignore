# Python virtual environments & caches
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class

# Temporary media & logs
.tempmediaStorage/
.system_generated/
*.log

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

